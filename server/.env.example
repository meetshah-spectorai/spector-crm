# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string. Verify it with: npm run db:check
#
# Atlas (Connect -> Drivers -> Node.js). Note the /crm before the "?" — without a
# database name MongoDB silently uses "test":
#   MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/crm?retryWrites=true&w=majority
#
# If the password contains @ : / ? # [ ] or %, percent-encode it (@ -> %40).
#
# Local mongod instead:
MONGO_URI=mongodb://127.0.0.1:27017/crm

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins (your Vercel URL in prod).
CLIENT_ORIGINS=http://localhost:5173

# --- Google sign-in ---------------------------------------------------------
# OAuth 2.0 *Web application* client id from https://console.cloud.google.com
# (APIs & Services -> Credentials). Add your frontend URL under "Authorized
# JavaScript origins" — http://localhost:5173 for local work.
#
# The same value goes in client/.env as VITE_GOOGLE_CLIENT_ID. No client secret
# is needed: the browser sends an ID token and the API verifies it against
# Google's public keys.
#
# Leave empty to keep the CRM on email + password only.
GOOGLE_CLIENT_ID=

# --- Email (Nodemailer / SMTP) ---------------------------------------------
# Leave SMTP_HOST empty to run in "console transport" mode: emails are printed
# to the server log instead of being sent. Handy for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CRM <no-reply@example.com>"

# SendGrid over SMTP: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587,
# SMTP_USER=apikey, SMTP_PASS=<your SendGrid API key>

# --- Reminders --------------------------------------------------------------
# Master switch for the background scheduler.
ENABLE_SCHEDULER=true
# Send the "due soon" email this many minutes before dueAt.
REMINDER_LEAD_MINUTES=30
# Daily digest of upcoming/overdue tasks. Cron is evaluated in DIGEST_TIMEZONE.
ENABLE_DAILY_DIGEST=true
DAILY_DIGEST_CRON=0 8 * * *
DIGEST_TIMEZONE=UTC

# Public URL of the frontend, used to build links inside emails.
APP_URL=http://localhost:5173

# --- Seed script ------------------------------------------------------------
# Your own account, created by `npm run seed` alongside two demo teammates.
SEED_NAME=You
SEED_EMAIL=you@example.com
SEED_PASSWORD=Passw0rd!
