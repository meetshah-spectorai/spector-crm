# Base URL of the CRM API.
#
# Local development: leave this empty. Vite proxies /api to the dev server
# (see vite.config.js), which keeps the app on a single origin.
#
# Production (Vercel): set to your deployed API, e.g.
#   VITE_API_BASE_URL=https://crm-api.onrender.com
VITE_API_BASE_URL=

# Optional: point the dev proxy somewhere other than http://localhost:5000
VITE_DEV_API_TARGET=http://localhost:5000
